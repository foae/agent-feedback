# Required credentials. Fill each value before starting either Compose stack;
# Compose rejects empty values and this example contains no usable credential.
# API key producers (multi-llm-review, second-opinion, friction submitters) must
# send as "Authorization: Bearer <key>" or "X-Api-Key: <key>".
API_KEY=

# Postgres superuser password for the compose-managed postgres:18-alpine container.
POSTGRES_PASSWORD=

# Use the same URL-encoded password above with the compose service name
# "postgres": postgres://feedback:<password>@postgres:5432/feedback?sslmode=disable
POSTGRES_URL=

# The HTTP port is loopback-only by default. Set to 0.0.0.0 only when an
# intentionally configured reverse proxy or firewall protects the service.
# FEEDBACK_BIND_ADDRESS=0.0.0.0
