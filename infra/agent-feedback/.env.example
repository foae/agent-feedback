# API key producers (multi-llm-review, second-opinion, friction submitters) must
# send as "Authorization: Bearer <key>" or "X-Api-Key: <key>".
API_KEY=change-me

# Postgres superuser password for the compose-managed postgres:17-alpine container.
POSTGRES_PASSWORD=change-me

# Derived from POSTGRES_PASSWORD above and the compose service name "postgres".
# Update the password portion if you change POSTGRES_PASSWORD.
POSTGRES_URL=postgres://feedback:change-me@postgres:5432/feedback?sslmode=disable
